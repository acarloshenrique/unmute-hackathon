# Demonstração local com pessoas fictícias. Nunca use dados reais neste modo.
CARECIRCLE_DEMO=true
# Opt-in legado de login público; mantenha false no fluxo de gateway restrito.
CARECIRCLE_PUBLIC_DEMO=false
CARECIRCLE_DB_PATH=.agent-local/carecircle.sqlite
# Opcional: somente para o copilot textual; a voz gerenciada não usa esta chave.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Nomes preservados do quickstart oficial. App ID é identificador público.
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=
# Origem HTTPS do gateway restrito (porta local 3002), nunca o app/login.
CARECIRCLE_VOICE_TOOL_URL=
# Hosts extras aceitos como origem, separados por vírgula (proxy de domínio da demo).
CARECIRCLE_ALLOWED_ORIGINS=

# Envios reais OFF por padrão; informe apenas números de teste com autorização.
# Configuração privada do servidor. Lista separada por vírgulas com +DDI.
CARECIRCLE_OUTREACH_ENABLED=false
CARECIRCLE_OUTREACH_TEST_NUMBERS=

# Texto no WhatsApp da demo. URL completa /message/sendText/{instancia} da Evolution v2.
# Somente no servidor, com a chave da instância autorizada.
CARECIRCLE_EVOLUTION_TEXT_URL=
CARECIRCLE_EVOLUTION_API_KEY=
