# Demonstração local com pessoas fictícias. Nunca use dados reais neste modo.
CARECIRCLE_DEMO=true
CARECIRCLE_DB_PATH=.agent-local/carecircle.sqlite
# Chave somente no servidor. A variável já existente no terminal também é aceita.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Nomes preservados do quickstart oficial. App ID é identificador público.
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=
# HTTPS público: Agora precisa alcançar /api/voice/llm/{session_id}
CARECIRCLE_PUBLIC_URL=
# Provedores gerenciados Agora; confirme suporte e habilitação na sua conta.
AGORA_TTS_VOICE=