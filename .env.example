# Demonstração local com pessoas fictícias. Nunca use dados reais neste modo.
CARECIRCLE_DEMO=true
# Opt-in legado de login público; mantenha false no fluxo de gateway restrito.
CARECIRCLE_PUBLIC_DEMO=false
CARECIRCLE_DB_PATH=.agent-local/carecircle.sqlite
# Opcional: somente para o copilot textual; a voz gerenciada não usa esta chave.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Nomes preservados do quickstart oficial. App ID é identificador público.
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=
# Origem HTTPS do gateway restrito (porta local 3002), nunca o app/login.
CARECIRCLE_VOICE_TOOL_URL=
