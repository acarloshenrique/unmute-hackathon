        <!-- ======= NÓS — BROWSER ======= -->
        <mxCell id="b0" value="Convite de conversa agendado por Ana&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(routine_run → notificação no app)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="50" y="85" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;① Helena toca «Conversar»&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mic só é pedido depois do toque&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="50" y="190" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;③ join RTC + RTM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;token 15 min · uid dedicado&lt;br&gt;mic publicado · legendas na tela&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="50" y="300" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="&lt;b&gt;⑦ Cartão «Podemos compartilhar?»&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Helena REVISA itens e destinatário&lt;br&gt;e toca «Confirmar e compartilhar»&lt;br&gt;(ou «Não compartilhar»)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="50" y="500" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- ======= NÓS — APP ======= -->
        <mxCell id="a2" value="&lt;b&gt;② POST /api/voice/start&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sessão cookie + role=elder + consent «checkins»&lt;br&gt;cria voice_session + capability (hash no DB)&lt;br&gt;AgoraClient.createSession.start&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="330" y="175" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="&lt;b&gt;⑤ POST /api/voice/tools/{sid}/prepare-request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Bearer capability · sessão ativa e íntegra&lt;br&gt;consent «family_updates» → Pedro&lt;br&gt;rascunho em proposals (pending · revision+1 · idempotente)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="330" y="340" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="&lt;b&gt;⑧ POST /api/actions/confirm_proposal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mesma revision exigida&lt;br&gt;→ task criada + notification p/ Pedro&lt;br&gt;idempotente — repetição não duplica&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="330" y="505" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- ======= NÓS — AGORA ======= -->
        <mxCell id="g3" value="&lt;b&gt;Agente managed entra no canal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;idle 30s · expira 15 min&lt;br&gt;SAL speaker-locking · VAD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="715" y="190" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="&lt;b&gt;④ fala → AresSTT (pt-PT)&lt;br&gt;→ gpt-4o-mini → decide tool&lt;br&gt;⑥ resposta → MiniMaxTTS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;«o pedido tá na tela pra você revisar»&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="715" y="320" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="g7" value="&lt;font style=&quot;font-size:10px&quot;&gt;correção falada «às dez da manhã»&lt;br&gt;→ nova tool call c/ expected_revision&lt;br&gt;revisa o MESMO rascunho (rev+1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;verticalAlign=middle;fontSize=10;dashed=1" vertex="1" parent="1">
          <mxGeometry x="715" y="455" width="240" height="75" as="geometry" />
        </mxCell>

        <!-- ======= NÓS — FAMÍLIA ======= -->
        <mxCell id="f10" value="&lt;b&gt;⑨ Pedro vê a tarefa no /familia&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;toca «Posso ajudar» → accepted&lt;br&gt;Helena recebe notificação (painel)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="1040" y="500" width="200" height="90" as="geometry" />
