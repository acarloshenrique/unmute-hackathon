        <!-- ======= LANES ======= -->
        <mxCell id="lane_browser" value="Navegador — /idoso (Dona Helena)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;container=1;collapsible=0" vertex="1" parent="1">
