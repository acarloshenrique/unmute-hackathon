<mxfile host="app.diagrams.net" agent="Devin" version="24.7.17" type="device">
  <diagram name="Fluxo canais reais" id="carecircle-fluxo-canais">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ======= NÓS PRINCIPAIS ======= -->
        <mxCell id="dash" value="&lt;b&gt;Painel /familia — «Canais reais»&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;familiar digita número + mensagem&lt;br&gt;botões: WhatsApp · Ligar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="outreach" value="&lt;b&gt;POST /api/outreach&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;{kind: whatsapp|call, to, message≤400}&lt;br&gt;exige sessão do app (cookie carecircle_session)&lt;br&gt;número normalizado: 10–15 dígitos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="350" y="85" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- ======= FRONTEIRA LOOPBACK ======= -->
        <mxCell id="g_loop" value="Fronteira de confiança — loopback 127.0.0.1 (sem auth HTTP; confiança por origem local e chave de serviço)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;verticalAlign=top;fontSize=11;fontStyle=2;spacingTop=6;container=1;collapsible=0;dashed=1" vertex="1" parent="1">
          <mxGeometry x="350" y="220" width="660" height="440" as="geometry" />
        </mxCell>
        <mxCell id="send" value="&lt;b&gt;lia-wa — POST /send (:8645)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;recusa origem ≠ 127.0.0.1/::1&lt;br&gt;prefixo «Aqui é a Lia, do CareCircle.» + texto&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="375" y="270" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dial" value="&lt;b&gt;naima-call — POST /dial (:8765)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;header X-Call-Key (lido de /opt/naima-call/.env)&lt;br&gt;to · persona=lia · say=mensagem&lt;br&gt;greeting=«Oi, aqui é a Lia do CareCircle.»&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="375" y="440" width="290" height="95" as="geometry" />
        </mxCell>
        <mxCell id="loop_note" value="&lt;font style=&quot;font-size:10px&quot;&gt;naima-call escuta só em 127.0.0.1 — sem X-Call-Key o /dial responde 401&lt;br&gt;/send, /meds, /contacts, /family do lia-wa também são loopback-only&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#7F1D1D" vertex="1" parent="1">
          <mxGeometry x="375" y="570" width="610" height="60" as="geometry" />
        </mxCell>

        <!-- ======= SAÍDAS ======= -->
        <mxCell id="fishpath" value="&lt;b&gt;Fish TTS → Evolution jazz2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fish_tts (opus) → /message/sendWhatsAppAudio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="700" y="275" width="285" height="70" as="geometry" />
        </mxCell>
        <mxCell id="twiliopath" value="&lt;b&gt;Twilio Calls API → PSTN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;caminho principal; Media Streams wss volta&lt;br&gt;via funnel /ligar-api → :8765 (voz ao vivo)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="700" y="410" width="285" height="80" as="geometry" />
        </mxCell>
        <mxCell id="agorafallback" value="&lt;b&gt;fallback — Agora ConvoAI Telephony&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /v2/outbound-dial (Elastic SIP trunk)&lt;br&gt;só se Twilio não configurado (TWILIO_* ausente)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="700" y="525" width="285" height="70" as="geometry" />
        </mxCell>

        <!-- ======= DESTINOS ======= -->
        <mxCell id="wa_rcpt" value="&lt;b&gt;WhatsApp do destinatário&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;recebe nota de voz da Lia&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="1030" y="275" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tel_rcpt" value="&lt;b&gt;Telefone toca (PSTN)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;a Lia fala a mensagem ao vivo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="1030" y="460" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- ======= EDGES ======= -->
        <mxCell id="c_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;endArrow=block" edge="1" parent="1" source="dash" target="outreach">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_e2" value="kind=whatsapp → http://127.0.0.1:8645/send" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6C8EBF;fontSize=10;endArrow=block" edge="1" parent="1" source="outreach" target="send">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_e3" value="kind=call → http://127.0.0.1:8765/dial" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6C8EBF;fontSize=10;endArrow=block" edge="1" parent="1" source="outreach" target="dial">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B85450;fontSize=10;endArrow=block" edge="1" parent="1" source="send" target="fishpath">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B85450;fontSize=10;endArrow=block" edge="1" parent="1" source="fishpath" target="wa_rcpt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B85450;fontSize=10;endArrow=block" edge="1" parent="1" source="dial" target="twiliopath">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B85450;fontSize=10;endArrow=block" edge="1" parent="1" source="twiliopath" target="tel_rcpt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_e8" value="se Twilio não configurado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82B366;fontSize=10;endArrow=block;dashed=1" edge="1" parent="1" source="dial" target="agorafallback">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82B366;fontSize=10;endArrow=block;dashed=1" edge="1" parent="1" source="agorafallback" target="tel_rcpt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;font style=&quot;font-size:10px&quot;&gt;Envio manual e autenticado a partir do painel — não há disparo automático do app para WhatsApp/telefone. Personas e dados sintéticos.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="800" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
